# Server
PORT=3001
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://gamesales:gamesales@localhost:5433/gamesales"

# Optional: direct (non-pooled) connection string, used exclusively to run
# database migrations at app boot. Required when DATABASE_URL points at a
# transaction-mode pooler (Neon `-pooler.…neon.tech`, Supabase pooler on
# port 6543, pgbouncer in transaction mode, …): TypeORM DDL relies on
# session-scoped state that those poolers don't preserve. If unset, the
# migration runner falls back to DATABASE_URL.
#
# Example (Neon): same URL as DATABASE_URL minus the `-pooler` suffix:
#   postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
DATABASE_URL_DIRECT=

# IGDB (Twitch) API credentials: https://api-docs.igdb.com/#getting-started
# Create an app at https://dev.twitch.tv/console/apps to get these.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Steam Web API key (optional, only needed for some endpoints): https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# OpenAI: used only to extract sales figures from fetched text (Wikipedia,
# later press/social). The model never invents data — extractions are grounded
# and rejected if their verbatim quote is absent from the source text.
# Without a key, text-extraction sources are skipped.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional reasoning effort passed to the extraction call. When unset, it is
# derived from OPENAI_MODEL: gpt-5.x models (e.g. gpt-5.6-luna) default to
# `none` (required for function tools on /v1/chat/completions), other models
# send nothing. Set explicitly to override (minimal|low|medium|high), or to an
# empty value to force sending nothing.
OPENAI_REASONING_EFFORT=

# Backlog article discovery (`discoverBacklog`): Perplexity first, then Tavily
# when Perplexity is missing a key, out of credit, or in a credit cooldown.
# A credit/billing failure trips a 24h DB cooldown (`provider_cooldown`) so
# harvest crons do not re-probe a dead balance on every game. Each result's
# page text goes through the same grounded LLM extractor. Without either key,
# backlog web discovery is skipped (Wikipedia harvest still runs).
# Get keys at https://www.perplexity.ai/settings/api and https://app.tavily.com
PERPLEXITY_API_KEY=
TAVILY_API_KEY=

# games-popularity.com: free third-party tracker used to BACKFILL Steam
# followers + top-seller rank (metrics we don't collect to launch depth
# ourselves). Get a free key at https://games-popularity.com (query param
# `apiKey`; without a key the follower / rank backfill + weekly cron are
# skipped). NOTE: history only reaches ~2024-03, not launch.
GAMES_POPULARITY_API_KEY=

# Back-office admin (allowlist + password). No public registration.
#
# ADMIN_SESSION_SECRET — required HMAC key for signed sessions (fail-closed when unset).
# ADMIN_BOOTSTRAP_EMAIL / ADMIN_BOOTSTRAP_PASSWORD — create the first admin on
#   boot if that email is missing (password ≥ 12 chars). Remove the password
#   from env after the first successful login.
ADMIN_SESSION_SECRET=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Welcome email on admin account creation (Resend). Optional — skipped when unset.
# PUBLIC_APP_URL is used for the /admin/login link in the mail (e.g. https://example.com).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Game Sales Tracker <noreply@gamesalestracker.tech>
PUBLIC_APP_URL=http://localhost:3000

