# Server
PORT=3001
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://gamesales:gamesales@localhost:5433/gamesales"

# IGDB (Twitch) API credentials: https://api-docs.igdb.com/#getting-started
# Create an app at https://dev.twitch.tv/console/apps to get these.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Steam Web API key (optional, only needed for some endpoints): https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# OpenAI: used only to extract sales figures from fetched text (Wikipedia,
# later press/social). The model never invents data — extractions are grounded
# and rejected if their verbatim quote is absent from the source text.
# Without a key, text-extraction sources are skipped.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Tavily web search: used only to discover BACKLOG sales articles (coverage
# published before we started polling RSS feeds). Each result's page text is
# run through the same grounded LLM extractor as every other source, so figures
# remain traceable to a real URL and a verbatim quote. Wikipedia + RSS cover
# ongoing news; Tavily fills the historical gap. Without a key, backlog web
# discovery is skipped. Get a key at https://app.tavily.com
TAVILY_API_KEY=

# Back-office admin: shared secret required to access the /admin endpoints.
# Set to any long random string. The frontend posts it through a server action
# which stores it in an HttpOnly cookie; clients never see it. Leave empty to
# disable the admin surface entirely (fail-closed).
ADMIN_TOKEN=
