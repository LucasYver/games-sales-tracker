# Server
PORT=3001
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://gamesales:gamesales@localhost:5433/gamesales"

# Optional: direct (non-pooled) connection string, used exclusively to run
# database migrations at app boot. Required when DATABASE_URL points at a
# transaction-mode pooler (Neon `-pooler.…neon.tech`, Supabase pooler on
# port 6543, pgbouncer in transaction mode, …): TypeORM DDL relies on
# session-scoped state that those poolers don't preserve. If unset, the
# migration runner falls back to DATABASE_URL.
#
# Example (Neon): same URL as DATABASE_URL minus the `-pooler` suffix:
#   postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
DATABASE_URL_DIRECT=

# IGDB (Twitch) API credentials: https://api-docs.igdb.com/#getting-started
# Create an app at https://dev.twitch.tv/console/apps to get these.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Steam Web API key (optional, only needed for some endpoints): https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# OpenAI: used only to extract sales figures from fetched text (Wikipedia,
# later press/social). The model never invents data — extractions are grounded
# and rejected if their verbatim quote is absent from the source text.
# Without a key, text-extraction sources are skipped.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Tavily web search: used only to discover BACKLOG sales articles (coverage
# published before we started polling RSS feeds). Each result's page text is
# run through the same grounded LLM extractor as every other source, so figures
# remain traceable to a real URL and a verbatim quote. Wikipedia + RSS cover
# ongoing news; Tavily fills the historical gap. Without a key, backlog web
# discovery is skipped. Get a key at https://app.tavily.com
TAVILY_API_KEY=

# Perplexity Search API: alternative / complementary backlog discovery engine.
# Pricing is $5 / 1000 requests with no per-token cost, and the API supports
# multi-query batching (up to 5 queries per call). Get a key at
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Which engine drives backlog discovery (`discoverBacklog`):
#   - perplexity  (default) — use Perplexity only (best price/perf, native
#                 multi-query batching, reliable publication dates)
#   - tavily      — use Tavily only (higher result volume, no dates)
#   - both        — run both in parallel, dedupe URLs across engines
# Falls back silently to whichever engine is configured when one of the two
# API keys is missing.
BACKLOG_SEARCH_ENGINE=perplexity

# Back-office admin: shared secret required to access the /admin endpoints.
# Set to any long random string. The frontend posts it through a server action
# which stores it in an HttpOnly cookie; clients never see it. Leave empty to
# disable the admin surface entirely (fail-closed).
ADMIN_TOKEN=
