{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "run",
        "start"
      ],
      "port": 3001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "ml2",
      "runtimeExecutable": "ml/.venv/bin/streamlit",
      "runtimeArgs": [
        "run",
        "ml2/app.py",
        "--server.port",
        "8512",
        "--server.headless",
        "true"
      ],
      "port": 8512
    }
  ]
}