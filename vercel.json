{
    "version": 2,
    "regions": ["cdg1"],
    "builds": [
        {
            "src": "backend/api/index.ts",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/next"
        }
    ],
    "routes": [
        {
            "src": "/api(.*)",
            "dest": "backend/api/index.ts"
        }
    ],
    "crons": [
        { "path": "/api/cron/steam-reviews", "schedule": "15 0,4,8,12,16,20 * * *" },
        { "path": "/api/cron/steam-reviewer-playtime", "schedule": "40 0,6,12,18 * * *" },
        { "path": "/api/cron/estimate-rebuild", "schedule": "45 4 * * *" },
        { "path": "/api/cron/store-ratings", "schedule": "15 1,5,9,13,17,21 * * *" },
        { "path": "/api/cron/achievements", "schedule": "15 8 * * *" },
        { "path": "/api/cron/milestone-harvest", "schedule": "30 0,6,12,18 * * *" },
        { "path": "/api/cron/steam-ccu", "schedule": "0 * * * *" },
        { "path": "/api/cron/twitch-viewers", "schedule": "15,45 * * * *" },
        { "path": "/api/cron/steam-prices", "schedule": "20 6,14,22 * * *" },
        { "path": "/api/cron/xbox-prices", "schedule": "40 6,14,22 * * *" },
        { "path": "/api/cron/ps-prices", "schedule": "0 6,14,22 * * *" },
        { "path": "/api/cron/sales-feeds", "schedule": "*/30 * * * *" },
        { "path": "/api/cron/game-discovery", "schedule": "0 2 * * *" },
        { "path": "/api/cron/steam-followers", "schedule": "0 4,16 * * *" },
        { "path": "/api/cron/game-rank", "schedule": "0 5 * * 1" }
    ]
}
