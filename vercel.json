{
    "version": 2,
    "regions": ["cdg1"],
    "builds": [
        {
            "src": "backend/api/index.ts",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/next"
        }
    ],
    "routes": [
        {
            "src": "/api(.*)",
            "dest": "backend/api/index.ts"
        }
    ],
    "crons": [
        { "path": "/api/cron/refresh-steam",  "schedule": "0 3 * * *" },
        { "path": "/api/cron/poll-feeds",      "schedule": "0 12 * * *" },
        { "path": "/api/cron/discover-games",  "schedule": "0 2 * * *" }
    ]
}