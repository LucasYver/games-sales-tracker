{
    "version": 2,
    "regions": ["cdg1"],
    "builds": [
        {
            "src": "backend/api/index.ts",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/next"
        }
    ],
    "routes": [
        {
            "src": "/api(.*)",
            "dest": "backend/api/index.ts"
        }
    ],
    "crons": [
        { "path": "/api/cron/poll-reviews",    "schedule": "15 1,7,13,19 * * *" },
        { "path": "/api/cron/rebuild-estimates", "schedule": "45 1,7,13,19 * * *" },
        { "path": "/api/cron/capture-store-ratings", "schedule": "15 3 * * *" },
        { "path": "/api/cron/capture-achievements",  "schedule": "15 8 * * *" },
        { "path": "/api/cron/harvest-milestones", "schedule": "30 0,6,12,18 * * *" },
        { "path": "/api/cron/poll-ccu",        "schedule": "0 * * * *" },
        { "path": "/api/cron/poll-twitch-viewers", "schedule": "30 * * * *" },
        { "path": "/api/cron/capture-prices",  "schedule": "0 6 * * *" },
        { "path": "/api/cron/poll-feeds",      "schedule": "*/30 * * * *" },
        { "path": "/api/cron/discover-games",  "schedule": "0 2 * * *" },
        { "path": "/api/cron/capture-popularity", "schedule": "0 4 * * 1" },
        { "path": "/api/cron/recompute-rank",     "schedule": "0 5 * * 1" }
    ]
}
